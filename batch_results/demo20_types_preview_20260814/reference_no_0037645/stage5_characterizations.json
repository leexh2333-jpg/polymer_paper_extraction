      "sample_resolution_status": "multi_resolved",
      "parameters": {
        "detectors": "refractive index (RI) and multiangle laser light scattering (MALLS)"
      },
      "result_summary": "Monomodal elution profiles with narrow PDI (1.11-1.18) observed for all polymers; absolute molecular weights determined, DP nearly unchanged relative to starting PSSiMe<sub>3</sub>, no backbone cleavage or cross-linking during synthesis.",
      "derived_property_ids": [],
      "evidence": [
        {
          "block_id": "P_2_29",
          "page": 2,
          "bbox": [
            81.0,
            651.0,
            483.0,
            929.0
          ],
          "source_type": "text",
          "source_sentence": "The new quinolate polymers were subjected to gel permeation chromatography (GPC) analysis in THF for determination of the molecular weights using refractive index (RI) and multiangle laser light scattering (MALLS) detectors (Table 1)."
        },
        {
          "block_id": "P_2_30",
          "page": 2,
          "bbox": [
            83.0,
            928.0,
            483.0,
            957.0
          ],
          "source_type": "text",
          "source_sentence": "We turned to in-line GPC-MALLS (multiangle laser light scattering) detection for the determination of absolute molecular weights."
        }
      ],
      "confidence": {
