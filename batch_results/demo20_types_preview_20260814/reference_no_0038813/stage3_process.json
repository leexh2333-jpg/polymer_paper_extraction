      "evidence": {
        "block_id": "P_2_37",
        "page": 2,
        "bbox": [
          87.0,
          64.0,
          500.0,
          193.0
        ],
        "source_type": "text",
        "source_sentence": "75 ml of hydrazine monohydrate was added dropwise over a period of 1 hr at 858C. After the complete addition, the reaction was continued at reflux temperature for another 12 hr. To the suspension, 80 ml of tetrahydrofuran (THF) was added to re-dissolve the precipitated product, and refluxing was continued for 3 hr. The mixture was filtered to remove the Pd–C and the filtrate was poured into water. The product was filtered off, washed with hot water, and dried. The yield of the reaction was about 92%."
      },
      "confidence": {
        "score": 0.9
      }
    },
    {
