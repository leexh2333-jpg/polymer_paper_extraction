        ],
        "source_type": "text",
        "source_sentence": "A mixture of 1 mole of diethyl (or dimethyl) ester of a dibasic acid and 3 moles of hydrazine hydrate was refluxed in 500–1000 ml. of dry methanol for 4–24 hr."
      },
      "confidence": {
        "score": 0.85
      }
    },
    {
      "step_id": "ps002",
      "process_type": "polymerization",
      "input_sample_ids": [
